        "@swimlane/ngx-charts": "^14.0.0",
        "@swimlane/ngx-datatable": "^17.0.0",
        "@swimlane/ngx-dnd": "^8.1.1",
        "@types/prismjs": "^1.16.1",
        "angular-calendar": "0.28.16",
        "angular-in-memory-web-api": "^0.9.0",
        "chart.js": "^2.9.3",
